# Copiar a .env.local. Node 24 recomendado. No contiene claves AWS.
KAFKA_BROKERS=localhost:9092
FRONTEND_ORIGIN=http://localhost:5173
HTTP_HOST=127.0.0.1

# GUIA AWS: dejar comentado durante toda la guia local.
