{
  "name": "pedidos360-zookeeper",
  "version": "1.0.0",
  "description": "DSY1107 - Cómo funciona ZooKeeper: ensamble, znodes, watches, configuración, registro de servicios, elección de líder y el controlador de Kafka",
  "private": true,
  "scripts": {
    "up": "docker compose up -d",
    "up:kafka": "docker compose --profile kafka up -d",
    "down": "docker compose --profile kafka down",
    "estado": "node ensamble/estado.js",
    "arbol": "node znodes/arbol.js",
    "znodes": "node znodes/tour.js",
    "config": "node config/servicio.js",
    "config:set": "node config/cambiar.js",
    "servicio": "node registro/servicio.js",
    "descubrir": "node registro/descubrir.js",
    "candidato": "node lider/candidato.js",
    "controlador": "node kafka/controlador.js"
  },
  "dependencies": {
    "node-zookeeper-client": "^1.1.3"
  }
}
